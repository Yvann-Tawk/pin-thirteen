{
  "name": "pin-thirteen",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pin-thirteen/web dev",
    "build": "pnpm --filter @pin-thirteen/web build",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
